# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会提交；本文件里不要写真实密钥

# ===== 基础配置 =====
APP_NAME=nextbos-ai
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ===== Redis（短期记忆 checkpoint）=====
REDIS_URL=redis://localhost:6379/0
REDIS_CHECKPOINT_TTL_SECONDS=604800

# ===== PostgreSQL（长期记忆）=====
POSTGRES_DSN=postgresql+asyncpg://agent:agent@localhost:5432/agent_runtime

# ===== LLM 运行时配置 =====
# provider=none 时不启用 LLM（回显模式，无需密钥即可跑通）
# 常见 OpenAI 兼容接口示例：
#   DeepSeek:  https://api.deepseek.com/v1        deepseek-chat
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-max
#   Kimi:      https://api.moonshot.cn/v1         moonshot-v1-8k
#   OpenAI:    https://api.openai.com/v1          gpt-4o
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=

# ===== 后台动态配置的加密密钥（预留，暂未启用）=====
# 用于把管理后台设置的 api_key 加密后落库；32 字节随机串：openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=


# OpenTelemetry / SigNoZ
# 默认关闭；本地启动 SigNoZ 或 OTLP Collector 后再打开。
OTEL_ENABLED=false

# SigNoZ 里展示的服务名。
OTEL_SERVICE_NAME=nextbos-ai

# 本地 SigNoZ / OpenTelemetry Collector 的 gRPC OTLP 地址。
# 常见值：http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# SigNoZ Cloud 或需要鉴权的 Collector 才需要。
# 注意不要把真实 token 提交到仓库。
OTEL_EXPORTER_OTLP_HEADERS=

# trace 采样率：1.0 = 全量采样。
OTEL_TRACES_SAMPLE_RATE=1.0
